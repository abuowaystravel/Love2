<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="مفاجأة رومانسية">
  <title>💘 مفاجأة خاصة</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: Arial, Tahoma, sans-serif;
      background: linear-gradient(135deg, #ff758c, #ff7eb3);
      overflow: hidden;
      color: #333;
    }

    .hearts span {
      position: fixed;
      bottom: -40px;
      font-size: 24px;
      animation: float 8s linear infinite;
      opacity: 0.75;
      pointer-events: none;
    }

    .hearts span:nth-child(1) {
      left: 8%;
      animation-delay: 0s;
    }

    .hearts span:nth-child(2) {
      left: 25%;
      animation-delay: 2s;
    }

    .hearts span:nth-child(3) {
      left: 48%;
      animation-delay: 4s;
    }

    .hearts span:nth-child(4) {
      left: 70%;
      animation-delay: 1s;
    }

    .hearts span:nth-child(5) {
      left: 88%;
      animation-delay: 3s;
    }

    @keyframes float {
      to {
        transform: translateY(-115vh) rotate(20deg);
        opacity: 0;
      }
    }

    .card {
      width: min(92%, 430px);
      background: #fff;
      border-radius: 28px;
      padding: 32px 25px;
      text-align: center;
      box-shadow: 0 20px 60px #0003;
      position: relative;
      z-index: 2;
    }

    .icon {
      font-size: 64px;
      margin-bottom: 8px;
    }

    h1 {
      margin: 5px 0 10px;
      color: #e91e63;
      font-size: 30px;
    }

    p {
      line-height: 1.8;
      margin: 10px 0 22px;
    }

    input {
      width: 100%;
      padding: 14px 16px;
      margin: 7px 0;
      border: 1px solid #ddd;
      border-radius: 14px;
      font-size: 16px;
      outline: none;
    }

    input:focus {
      border-color: #e91e63;
      box-shadow: 0 0 0 3px #e91e6315;
    }

    button {
      width: 100%;
      border: 0;
      border-radius: 14px;
      padding: 15px;
      margin-top: 10px;
      background: #e91e63;
      color: #fff;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #c2185b;
    }

    .small {
      font-size: 12px;
      color: #888;
      margin-top: 14px;
    }

    #surprise {
      display: none;
    }

    .big {
      font-size: 70px;
    }

    .success {
      font-size: 25px;
      color: #e91e63;
      font-weight: bold;
    }

    .note {
      background: #fff5f8;
      border-radius: 18px;
      padding: 16px;
      margin-top: 15px;
    }
  </style>
</head>

<body>

  <!-- القلوب المتحركة -->
  <div class="hearts">
    <span>❤️</span>
    <span>💖</span>
    <span>💕</span>
    <span>💘</span>
    <span>❤️</span>
  </div>

  <!-- صفحة الدخول -->
  <main class="card" id="login">

    <div class="icon">💌</div>

    <h1>عندك مفاجأة خاصة ❤️</h1>

    <p>
      في رسالة سرية من مصعب...<br>
      سجّلي دخولك عشان تفتحي المفاجأة 😅
    </p>

    <!-- هذه الخانات لا ترسل أو تحفظ أي بيانات -->
    <input
      id="name"
      type="text"
      placeholder="اكتبي اسمك 😍"
      autocomplete="off"
    >

    <input
      id="fakePassword"
      type="text"
      placeholder="كلمة سر الحب ❤️"
      autocomplete="off"
    >

    <button onclick="openSurprise()">
      🔓 فتح المفاجأة
    </button>

    <div class="small">
      😂 مقلب رومانسي آمن — لا يتم حفظ أو إرسال أي بيانات.
    </div>

  </main>

  <!-- المفاجأة -->
  <main class="card" id="surprise">

    <div class="big">🎣🤣</div>

    <div class="success">
      تم اصطيادك بنجاح! ❤️
    </div>

    <div class="note">

      <p>
        <strong>مبرووووك 😂</strong>
      </p>

      <p>
        مصعب أخذ شهادة Cybersecurity 🎓💻
      </p>

      <p>
        والآن مهمتك الرسمية:
        حضور الاحتفال والعشاء علينا! 🍽️❤️
      </p>

    </div>

    <p>
      اطمئني 😄 هذه كانت مجرد مزحة،
      ولم يتم تسجيل أو إرسال أي كلمة مرور.
    </p>

  </main>

  <script>

    function openSurprise() {

      document.getElementById("login").style.display = "none";

      document.getElementById("surprise").style.display = "block";

      document.title = "🎣 تم الاصطياد 😂";

    }

  </script>

</body>
</html>
